        //         const nombreLista = document.getElementById("NombreLista").value;
        //         const alumnosCant = parseInt(document.getElementById("CantidadAlumnos").value);
        //         const filas = document.querySelectorAll("#tbodyProductos tr");
        //         let IdUsuario = $("#MaestraLista").val();
