<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] </title>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
              asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute"
              crossorigin="anonymous"
              integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" />
    </environment>
    
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/menu.css" />
    <link rel="stylesheet" href="~/css/snackbar.css" />
    <link rel="stylesheet"  href="~/css/select2.css" />
    <link rel="icon" type="image/png" href="~/image/logo.png" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css">


</head>
<body class="bg-light">

    <input style="display:none;" />
    <input style="display:none;" type="password" />
    <!-- NAVBAR HORIZONTAL RESPONSIVE -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
        <div class="container-fluid ">
           
            <a class="navbar-brand" asp-area="" asp-page="/Listas/Index">
                <img src="~/images/logo.png" width="100" alt="Logo" />
            </a>

           
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

           
            <div class="collapse navbar-collapse" id="mainNavbar">
                
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-area="" asp-page="/Listas/Create">
                            <i class="fas fa-plus-circle" style="color:orange; font-size: 20px; margin-right:8px;"></i>
                            Nuevo Pedido
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-area="" asp-page="/Listas/Index">
                            <i class="fas fa-list" style="color:orange; font-size: 20px; margin-right:8px;"></i>
                            Listado de Pedidos
                        </a>
                    </li>
                    @if (Convert.ToBoolean(User.Claims.FirstOrDefault(c => c.Type == "Admin").Value) == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" asp-area="" asp-page="/Articulos/Index">
                                <i class="fas fa-sitemap" style="color:orange; font-size: 20px; margin-right:8px;"></i>
                                Articulos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" asp-area="" asp-page="/Usuarios/Index">
                                <i class="fas fa-user" style="color:orange; font-size: 20px; margin-right:8px;"></i>
                                Usuarios
                            </a>
                        </li>
                    }
                </ul>


                <!-- Usuario (dropdown) -->
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown" role="button"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-user" style="color:orange"></i>
                            <small>@User.Claims.FirstOrDefault(c => c.Type == "Mail")?.Value</small>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                            <a class="dropdown-item"
                               data-id='@User.Claims.FirstOrDefault(c => c.Type == "IdUsuario")?.Value'
                               data-toggle="modal" data-target="#modalClave">
                                Cambiar Clave
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-area="" asp-page="/Login" asp-page-handler="Logout">
                                Cerrar Sesión
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="container-fluid mt-5">
        <main role="main" class="pb-3 " style="margin-top: 5rem !important;">
            @{
                var showCrud = Context.Request.Path.ToString().ToLower().Contains("configuraciones");
                var showReportes = Context.Request.Path.ToString().ToLower().Contains("reportes");
            }

            @if (showCrud)
            {
                <div class="row">
                    <div class="col-sm-12 col-md-3">
                        <partial name="_SideBarMenu" />
                    </div>
                    <div class="col-sm-12 col-md-9">
                        <div class="my-2 p-3 bg-white rounded shadow-sm">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            }
            else if (showReportes)
            {
                <div class="row">
                    <div class="col-sm-12">
                        <div class="my-2 p-3 bg-white rounded shadow-sm">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-sm-12">
                        <div class="my-2 p-3 bg-white rounded shadow-sm">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            }
        </main>
      

    </div>




    <div id="modalClave" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <label> Ingrese su nueva clave para acceder al sistema</label>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <input type="hidden" id="idUsuarioModal" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label> Nueva Clave</label>
                                <input class="form-control" placeholder="Nueva clave" type="password" id="idClaveModal" required />
                            </div>
                            <div class="form-group">
                                <label> Repetir clave</label>
                                <input class="form-control" placeholder="Repetir clave" type="password" id="idRepetirClaveModal" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary float-right" type="button" onclick="ValidarFormRestablecerClave();">Modificar</button>
                </div>
            </div>
        </div>
    </div>




    <div id="snackbar">Clave modificada con exito</div>


    <div id="alertaOk" class="alert alert-success shadow my-3" role="alert" style="border-radius: 3px;position: absolute;bottom: 0;right: 15px; z-index: 9999; display:none">
        <button type="button" class="close" id="btnAlertaOkCerrar">
            <span aria-hidden="True" style="color:#155724">&times;</span>
        </button>
        <p style="font-size:18px" class="mb-0 font-weight-light" id="tituloAlerta"><b class="mr-1"></b>This example text in a custom alert.</p>
    </div>


    <script src="~/lib/jquery/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-mask-plugin@1.14.16/dist/jquery.mask.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.27.0/moment.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.6.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/1.10.21/sorting/datetime-moment.js"></script>
    <script src="https://cdn.datatables.net/rowreorder/1.2.7/js/dataTables.rowReorder.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.flash.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.6.2/js/buttons.html5.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/menu.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/alerta.js" asp-append-version="true"></script>
    <script type="text/javascript">


        $('#modalClave').on('show.bs.modal', function (e) {
            $("#idUsuarioModal").val($(e.relatedTarget).data("id"));
        });





        function ValidarFormRestablecerClave() {

            if ($("#idClaveModal").val() != "") {
                if ($("#idClaveModal").val() != "") {
                    if ($("#idClaveModal").val() == $("#idClaveModal").val()) {
                        idUsuario = $("#idUsuarioModal").val();
                        clave = $("#idClaveModal").val();


                        $.ajax({
                            url: `../api/tablas/PostClave/${idUsuario}/${clave}`,
                            "method": "POST",
                        }).done(function (response) {
                            $("#modalClave").modal('hide');
                            var x = document.getElementById("snackbar");

                            // Add the "show" class to DIV
                            x.className = "show";

                            // After 3 seconds, remove the show class from DIV
                            setTimeout(function () { x.className = x.className.replace("show", ""); }, 2000);

                        });


                    }
                    else {
                        $("#idClaveModal").addClass("invalid");
                        $("#idClaveModal").addClass("invalid");
                        alert('Las claves no coinciden');
                    }

                }
                else {
                    $("#idClaveModal").addClass("invalid");
                    alert('Las claves no puede ser vacia');
                }


            }
            else {
                $("#idClaveModal").addClass("invalid");
                alert('Las claves no puede ser vacia');
            }

        }


    </script>


    @RenderSection("Scripts", required: false)
</body>
</html>
